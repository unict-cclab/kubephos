{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kubephos.dev/contracts/v1alpha1/plan.schema.json",
  "title": "KubePhos Resolved Plan",
  "type": "object",
  "required": ["pluginId", "steps"],
  "properties": {
    "pluginId": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["id", "name", "input"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "input": {},
          "mutating": { "type": "boolean", "default": false },
          "cleanup": { "type": "boolean", "default": false },
          "artifactInputs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type", "version"],
              "properties": {
                "name": { "$ref": "#/$defs/outputName" },
                "type": { "$ref": "#/$defs/artifactType" },
                "version": { "$ref": "#/$defs/artifactVersion" },
                "artifactId": { "type": "string", "pattern": "^art_[A-Za-z0-9]+$" },
                "fromStep": { "type": "string", "minLength": 1 },
                "fromOutput": { "$ref": "#/$defs/outputName" }
              },
              "additionalProperties": false
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "type", "version", "mediaType", "source"],
              "properties": {
                "name": { "$ref": "#/$defs/outputName" },
                "type": { "$ref": "#/$defs/artifactType" },
                "version": { "$ref": "#/$defs/artifactVersion" },
                "mediaType": { "const": "application/json" },
                "source": { "type": "string" },
                "sensitive": { "type": "boolean", "default": false }
              },
              "additionalProperties": false
            }
          },
          "effects": { "type": "array", "items": { "type": "object" } }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "outputName": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "artifactType": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9.-]{0,127}$" },
    "artifactVersion": { "type": "string", "pattern": "^v[0-9]+(alpha[0-9]+|beta[0-9]+)?$" }
  },
  "additionalProperties": false
}
