{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kubephos.dev/contracts/v1alpha1/plugin.schema.json",
  "title": "KubePhos Plugin",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "plugins.kubephos.io/v1alpha1" },
    "kind": { "const": "Plugin" },
    "metadata": {
      "type": "object",
      "required": ["id", "name", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": ["protocol", "commands", "configurationSchema", "runtime"],
      "properties": {
        "protocol": { "const": "v1alpha1" },
        "provider": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{1,63}$" },
        "commands": {
          "type": "array",
          "items": { "enum": ["describe", "validate", "plan", "precheck", "execute", "verify", "status", "pause", "resume", "cancel", "cleanup"] },
          "minItems": 7,
          "uniqueItems": true
        },
        "configurationSchema": { "type": "object" },
        "credentialSchemas": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "name", "schema"],
            "properties": {
              "kind": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "description": { "type": "string" },
              "schema": { "type": "object" }
            },
            "additionalProperties": false
          }
        },
        "runtime": {
          "type": "object",
          "required": ["executable"],
          "properties": {
            "executable": { "type": "string", "minLength": 1 },
            "timeout": { "type": "string", "minLength": 2 }
          },
          "additionalProperties": false
        },
        "artifacts": {
          "type": "object",
          "properties": {
            "inputs": { "$ref": "#/$defs/artifactContracts" },
            "outputs": { "$ref": "#/$defs/artifactContracts" }
          },
          "additionalProperties": false
        },
        "capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "permissions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "artifactContracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "version"],
        "properties": {
          "type": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9.-]{0,127}$" },
          "version": { "type": "string", "pattern": "^v[0-9]+(alpha[0-9]+|beta[0-9]+)?$" }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
