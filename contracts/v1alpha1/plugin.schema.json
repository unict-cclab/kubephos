{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kubephos.dev/contracts/v1alpha1/plugin.schema.json",
  "title": "KubePhos Plugin",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "plugins.kubephos.io/v1alpha1" },
    "kind": { "const": "Plugin" },
    "metadata": {
      "type": "object",
      "required": ["id", "name", "version"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,126}[a-z0-9])?$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^(?:\\S|\\S(?:[\\s\\S]*\\S)?)$"
        },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
        },
        "description": { "type": "string", "maxLength": 500 }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": ["protocol", "commands", "configurationSchema", "runtime"],
      "properties": {
        "protocol": { "const": "v1alpha1" },
        "provider": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,78}[a-z0-9])?$"
        },
        "commands": {
          "type": "array",
          "items": {
            "enum": ["describe", "validate", "plan", "precheck", "execute", "verify", "status", "cancel", "cleanup"]
          },
          "minItems": 9,
          "maxItems": 9,
          "uniqueItems": true
        },
        "configurationSchema": {
          "type": "object",
          "required": ["type"],
          "properties": { "type": { "const": "object" } }
        },
        "credentialSchemas": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "name", "schema"],
            "properties": {
              "kind": {
                "type": "string",
                "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,78}[a-z0-9])?$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^(?:\\S|\\S(?:[\\s\\S]*\\S)?)$"
              },
              "description": { "type": "string" },
              "schema": {
                "type": "object",
                "required": ["type"],
                "properties": { "type": { "const": "object" } }
              }
            },
            "additionalProperties": false
          }
        },
        "runtime": {
          "type": "object",
          "properties": {
            "executable": { "type": "string", "minLength": 1 },
            "image": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:(?:[._-][a-z0-9]+)|(?::[0-9]+))*(?:/[a-z0-9]+(?:[._-][a-z0-9]+)*)*(?::[A-Za-z0-9_][A-Za-z0-9._-]{0,127})?@sha256:[0-9a-f]{64}$"
            },
            "timeout": {
              "type": "string",
              "minLength": 2,
              "maxLength": 64,
              "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:h|m|s|ms|us|µs|ns))+$"
            }
          },
          "oneOf": [
            { "required": ["executable"] },
            { "required": ["image"] }
          ],
          "additionalProperties": false
        },
        "artifacts": {
          "type": "object",
          "properties": {
            "inputs": { "$ref": "#/$defs/artifactContracts" },
            "outputs": { "$ref": "#/$defs/artifactContracts" }
          },
          "additionalProperties": false
        },
        "capabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/manifestValue" },
          "uniqueItems": true
        },
        "permissions": {
          "type": "array",
          "items": { "$ref": "#/$defs/manifestValue" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "manifestValue": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]*(?::[a-z0-9][a-z0-9._-]{0,79})?$"
    },
    "artifactContracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "version"],
        "properties": {
          "type": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9.-]{0,127}$" },
          "version": { "type": "string", "pattern": "^v[0-9]+(?:alpha[0-9]+|beta[0-9]+)?$" }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
