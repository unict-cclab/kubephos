# Public, disposable development credentials. Not used by install.sh.
KUBEPHOS_IMAGE=kubephos
KUBEPHOS_VERSION=dev
KUBEPHOS_PORT=8088
KUBEPHOS_BIND_ADDRESS=127.0.0.1
KUBEPHOS_URL=http://127.0.0.1:8088
POSTGRES_PASSWORD=kubephos-local-development
KUBEPHOS_KEYCLOAK_CLIENT_SECRET=kubephos-local-client-secret
KUBEPHOS_KEYCLOAK_MANAGEMENT_CLIENT_SECRET=kubephos-local-management-secret
KUBEPHOS_KEYCLOAK_ADMIN_PASSWORD=kubephos-local-bootstrap-password
