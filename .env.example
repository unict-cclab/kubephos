# install.sh generates .env with unique credentials. This file documents its shape.
COMPOSE_PROJECT_NAME=kubephos
KUBEPHOS_VERSION=latest
KUBEPHOS_URL=http://localhost:8080
KUBEPHOS_PORT=8080
POSTGRES_PASSWORD=
KUBEPHOS_KEYCLOAK_CLIENT_SECRET=
KUBEPHOS_KEYCLOAK_MANAGEMENT_CLIENT_SECRET=
KUBEPHOS_KEYCLOAK_ADMIN_PASSWORD=
